# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION
# Provisioned automatically via Firebase tools.
# Stored in firebase-applet-config.json:
# - projectId: Google Cloud / Firebase project identifier
# - firestoreDatabaseId: Dedicated database instance identifier
# - appId: Web client application identifier
# - apiKey: Public client API key for Firebase Authentication
# - authDomain: Domain for Auth popup handling
# - storageBucket: Default Cloud Storage bucket for generated documents and uploads
